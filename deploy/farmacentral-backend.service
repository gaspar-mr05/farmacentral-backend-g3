[Unit]
Description=Farmacentral FastAPI backend
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=integracion
Group=integracion
WorkingDirectory=/opt/farmacentral-backend
EnvironmentFile=/opt/farmacentral-backend/.env
ExecStart=/opt/farmacentral-backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
