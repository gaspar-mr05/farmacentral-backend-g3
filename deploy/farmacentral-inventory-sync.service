[Unit]
Description=Synchronize Farmacentral inventory and enforce the cold chain
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=integracion
Group=integracion
WorkingDirectory=/home/integracion/farmacentral-backend
EnvironmentFile=/home/integracion/farmacentral-backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/integracion/farmacentral-backend/.venv/bin/python -m scripts.sync_inventory
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
UMask=0077
