APP_NAME=
APP_ENV=
# Step 26 monitor: canonical public HTTPS pages, no credentials or query string.
# E3_CUSTOMER_SITE_URL=https://your-public-site.example/
# E3_TRACEABILITY_SITE_URL=https://your-public-site.example/trazabilidad
# E3_MONITOR_OUTPUT=/var/lib/farmacentral/e3-monitor.jsonl
# APP_ENV_FILE selects one dotenv file and excludes .env.local. Set it in the
# process environment (systemd/release do this); setting it inside this file
# cannot select the file that is already being read.
# "auto" reads the deployed Git commit; an explicit hash remains supported.
APP_COMMIT_SHA=auto
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
FARMA_CENTRAL_BASE_URL=
FARMA_CENTRAL_API_SECRET=
FARMA_CENTRAL_FTP=
FARMA_CENTRAL_GROUP=3
FARMA_CENTRAL_TIMEOUT_SECONDS=10
# Optional: defaults to /ordenes-compra/ on the same host as Farma Central.
# PURCHASE_ORDERS_BASE_URL=https://dev.proyecto.2026-2.tallerdeintegracion.cl/ordenes-compra/
PURCHASE_ORDERS_TIMEOUT_SECONDS=10
# Trades authenticates independently from Farma Central and reuses group credentials.
# TRADES_BASE_URL=https://dev.proyecto.2026-2.tallerdeintegracion.cl/trades/
TRADES_TIMEOUT_SECONDS=10
# Billing SOAP reuses FARMA_CENTRAL_GROUP and FARMA_CENTRAL_API_SECRET.
# URLs default to /soap/billing and /soap/billing?wsdl on Farma Central's host.
# BILLING_URL=https://dev.proyecto.2026-2.tallerdeintegracion.cl/soap/billing
# BILLING_WSDL_URL=https://dev.proyecto.2026-2.tallerdeintegracion.cl/soap/billing?wsdl
BILLING_TIMEOUT_SECONDS=10
BILLING_REQUESTS_PER_MINUTE=45
# Reconciliation is opt-in: select an existing business_periods row explicitly.
# BILLING_PERIOD_ID=replace-with-period-uuid
BILLING_POLL_INTERVAL_SECONDS=60
BILLING_FULL_SYNC_INTERVAL_SECONDS=600
BILLING_BANK_INTERVAL_SECONDS=600
BILLING_STALE_AFTER_SECONDS=300
# Opt in to issuing invoices for officially fulfilled sales in the selected period.
BILLING_EMIT_SALES_ENABLED=false
BILLING_SALES_BATCH_SIZE=10
# Opt in to paying official client-side invoices in the selected period.
BILLING_PAY_INVOICES_ENABLED=false
BILLING_PAYMENTS_BATCH_SIZE=10
BUSINESS_METRICS_SNAPSHOT_INTERVAL_SECONDS=600
# Share this file across billing processes. Defaults to /var/lib/farmacentral/
# billing.rate when that directory exists, otherwise a per-user temporary file.
# BILLING_RATE_LIMIT_FILE=/var/lib/farmacentral/billing.rate
# sFTP: username follows the Farma Central environment unless explicitly set.
SFTP_HOST=choripan10.ing.uc.cl
SFTP_PORT=22
# SFTP_USERNAME=grupo3_desarrollo
# SFTP_PASSWORD=  # Defaults to FARMA_CENTRAL_FTP if omitted.
SFTP_DIRECTORY=.
# Defaults to the standard ~/.ssh/known_hosts when omitted.
# SFTP_KNOWN_HOSTS_FILE=/absolute/path/to/known_hosts
SFTP_TIMEOUT_SECONDS=10
SFTP_POLL_INTERVAL_SECONDS=30
SFTP_MAX_FILE_BYTES=65536
SFTP_BATCH_SIZE=100
# Pub/Sub: save the environment key outside the repository.
PUBSUB_PROJECT_ID=taller-integracion-310700
# Defaults to dev/prod.proyecto.2026-2.grupo3 based on FARMA_CENTRAL_BASE_URL.
# PUBSUB_TOPIC_ID=dev.proyecto.2026-2.grupo3
# Defaults to grupo3-dev or grupo3-prod.
# PUBSUB_SUBSCRIPTION_ID=grupo3-dev
# PUBSUB_CREDENTIALS_FILE=/absolute/path/to/grupo3-dev.json
PUBSUB_TIMEOUT_SECONDS=10
PUBSUB_POLL_INTERVAL_SECONDS=5
PUBSUB_BATCH_SIZE=100
EXTERNAL_ORDER_POLL_INTERVAL_SECONDS=5
EXTERNAL_ORDER_BATCH_SIZE=100
# Opt in to waiting for capacity before rejecting an external OC. 0 disables it.
# The wait ends earlier if needed to preserve the dispatch margin.
EXTERNAL_ORDER_STOCK_WAIT_SECONDS=3600
EXTERNAL_ORDER_STOCK_RETRY_SECONDS=30
EXTERNAL_ORDER_DISPATCH_MARGIN_SECONDS=300
# Messaging: the audience must equal the exact public webhook URL.
# Defaults to APP_PUBLIC_URL + /api/messaging, independent of request headers.
# MESSAGING_OIDC_AUDIENCE=https://choripan3.ing.uc.cl/api/messaging
MESSAGING_OIDC_SERVICE_ACCOUNT=mensajeria@taller-integracion-310700.iam.gserviceaccount.com
# Optional: defaults to /messaging/ on the same host as Farma Central.
# MESSAGING_BASE_URL=https://dev.proyecto.2026-2.tallerdeintegracion.cl/messaging/
MESSAGING_TIMEOUT_SECONDS=10
# Poll replies independently; the gateway client now coordinates LLM quota.
MESSAGING_POLL_INTERVAL_SECONDS=5
MESSAGING_BATCH_SIZE=10
# Recall webhook: defaults to APP_PUBLIC_URL + /api/recalls.
# RECALL_OIDC_AUDIENCE=https://choripan3.ing.uc.cl/api/recalls
# RECALL_POLL_INTERVAL_SECONDS=30
# RECALL_BATCH_SIZE=20
RECALL_OIDC_SERVICE_ACCOUNT=mensajeria@taller-integracion-310700.iam.gserviceaccount.com

# Replenishment uses official supply/production and does not call the LLM.
# Per kit: replenish below minimum, up to target; quantities follow catalog batches.
REPLENISHMENT_POLL_INTERVAL_SECONDS=60
# Suggested initial buffer; adjust to demand, space and shelf life.
REPLENISHMENT_MINIMUM_STOCK=4
REPLENISHMENT_TARGET_STOCK=8
# Exclude stock with less remaining shelf life from the minimum calculation.
REPLENISHMENT_MINIMUM_LIFETIME_SECONDS=14400
# Optional initial E3 spending envelope; otherwise one target basket at current
# kit prices. Confirmed positive invoiced margin adds room; full lot costs count.
# REPLENISHMENT_SPENDING_LIMIT=5000
OIDC_TIMEOUT_SECONDS=3
# LLM gateway: set the API base path published by the course (including /v1 if
# required). No requests are sent until the client is explicitly invoked.
# LLM_GATEWAY_BASE_URL=https://gateway.example.test/v1/
# LLM_GATEWAY_API_KEY=replace-with-group-key
# Available models: gemini-flash, gemini-flash-lite, gpt-oss-20b.
# LLM_GATEWAY_MODEL=gemini-flash-lite
# Shared group limits: 5 requests/minute, 1000 input+output tokens/minute,
# USD 2 every 30 days. The output cap does not limit total input+output usage.
LLM_GATEWAY_TIMEOUT_SECONDS=20
LLM_GATEWAY_MAX_TOKENS=256
# All gateway clients/tools on this host must share this file. Defaults to a
# group+gateway file under /var/lib/farmacentral, or a user directory in /tmp.
# LLM_GATEWAY_RATE_LIMIT_FILE=/var/lib/farmacentral/llm-group3.rate
# Reserve a full 1000-token window per call, plus its HTTP timeout. This is
# conservative pacing, not a tokenizer estimate or a replacement for the gateway.
LLM_GATEWAY_MIN_INTERVAL_SECONDS=60
MARKET_PRICE_CACHE_TTL_SECONDS=30
MARKET_PRICE_MAX_RETRY_WAIT_SECONDS=2
CHECKOUT_BASE_URL=https://dev.proyecto.2026-2.tallerdeintegracion.cl/
APP_PUBLIC_URL=http://127.0.0.1:8000/
# FRONTEND_PUBLIC_URL=http://127.0.0.1:3000/
CORS_ORIGINS=
# Private read-only diagnostics. Leave unset to disable /api/operations/*.
# Use an independent secret; never embed it in public frontend code.
# OPERATIONS_API_KEY=replace-with-a-private-random-key
